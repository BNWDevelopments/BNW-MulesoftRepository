	<munit:config name="bnw-meta-lead-integration-impl-test-suite.xml" />
	<munit:test name="200-success-bnw-verify-token" doc:id="f4dacd93-4232-4306-83c8-68143c18e6c0" description="Test">
		<munit:execution >
			<munit:set-event doc:name="Set Event" doc:id="534b44bd-5494-43c9-b88a-97746f74779c" >
				<munit:attributes value="#[readUrl('classpath://verifyTokenFlow/input_attributes.dwl')]" />
			</munit:set-event>
			<flow-ref doc:name="get:\meta-integration:bnw-meta-lead-integration-api-config" doc:id="fbabecac-569d-42fd-bc54-e9f7b53dc882" name="get:\meta-integration:bnw-meta-lead-integration-api-config"/>
		</munit:execution>
		<munit:validation >
			<logger level="INFO" doc:name="Logger" doc:id="94d79ea1-685d-4ba7-8fcd-38c10a41a4f8" message='#[attributes.queryParams."hub.challenge"]'/>
			<munit-tools:assert doc:name="Assert expression" doc:id="15366c90-04c7-465d-9e0a-dd76906e1328" >
				<munit-tools:that ><![CDATA[#[%dw 2.0
import verifyTokenFlow::verify_token_response
---
verify_token_response::main({payload: payload, attributes: attributes, vars: vars})]]]></munit-tools:that>
			</munit-tools:assert>
		</munit:validation>
	</munit:test>
	<munit:test name="403-invalid-verify-token-failure" doc:id="47f3ba7e-5807-4d85-8422-7ce5951b9500" >
