				<munit:payload value="#[readUrl('classpath://leadCreationFlow/ip_query_check_payload.dwl')]" />
			</munit:set-event>
			<flow-ref doc:name="BnW_Meta_Check_Campaign_Flow" doc:id="9666e0b5-58e2-4e0d-96ba-07099ff1bf80" name="BnW_Meta_Check_Campaign_Flow"/>
		</munit:execution>
	</munit:test>
	

