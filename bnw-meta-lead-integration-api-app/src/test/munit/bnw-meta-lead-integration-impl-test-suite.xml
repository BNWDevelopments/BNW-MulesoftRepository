	<munit:test name="200-success-bnw-lead-integration-impl-flow" doc:id="523a3879-0881-4ae9-b4dc-4c1e4ada807c" >
		<munit:behavior >
			<munit-tools:mock-when doc:name="Fetch Lead Details Requester" doc:id="1d7e48b4-f74d-4d18-9a42-1d872ae3d282" processor="http:request">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="65c4856b-f648-45fa-941d-19fafebdf339" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[readUrl('classpath://leadCreationFlow/fetch_lead_output.dwl')]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Fetch Ad details Requester" doc:id="0fa55431-7957-47f2-9563-36b6f5859b63" processor="http:request">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="4b92e45b-09f9-4e21-90db-18ad603d04df" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[readUrl('classpath://leadCreationFlow/fetch_ad_output.dwl')]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Salesforce Lead Create" doc:id="c39ca12d-0636-49ba-92eb-b8a2c4f4fce4" processor="salesforce:upsert">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="6e893096-bdcd-4fc2-8750-cdc28304ef61" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[readUrl('classpath://leadCreationFlow/create_lead_output.dwl')]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Salesforce Query Campaign" doc:id="1e12860d-59d8-4225-874b-3fe4f1db5ef7" processor="salesforce:query">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="53981331-ed20-40c1-8780-a6064128fe3f" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[readUrl('classpath://leadCreationFlow/campaign_query_output.dwl')]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Salesforce Upsert map Lead with Campaign" doc:id="59ca7846-f6e4-44c4-b045-78b58ab4f4f8" processor="salesforce:upsert">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="271cea0f-36a4-4bea-ac9f-64f2b0f379c0" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[readUrl('classpath://leadCreationFlow/lead_campaign_mapping_output.dwl')]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Salesforce Create Campaign Member" doc:id="449e4646-7f40-4c77-a0eb-5fac46417756" processor="salesforce:create">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="34d43a93-3f0c-4d85-a693-2df4c86205f5" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[readUrl('classpath://leadCreationFlow/campaign_memeber_output.dwl')]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<munit:set-event doc:name="Input Payload" doc:id="2c770b65-37a6-47bb-b395-1cebc85e0dee" >
				<munit:payload value="#[readUrl('classpath://leadCreationFlow/incoming_payload.dwl')]" />
			</munit:set-event>
			<flow-ref doc:name="post:\meta-integration:application\json:bnw-meta-lead-integration-api-config" doc:id="1a2ac847-a4f7-4400-9347-f414b562b1ee" name="post:\meta-integration:application\json:bnw-meta-lead-integration-api-config"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="Assert that" doc:id="e778996a-ba50-4062-8074-c9f873997549" message="Lead Creation failed." expression="#[payload.successful]" is="#[MunitTools::equalTo(true)]"/>
		</munit:validation>
	</munit:test>
	<munit:test name="lead-creation-failure-flow" doc:id="9d73a6c4-b654-49d6-802c-0731ed57436f" >
		<munit:execution>
			<munit:set-event doc:name="Set Event" doc:id="250a9586-4e55-47c7-9a80-56303afca682" >
				<munit:payload value="#[readUrl('classpath://leadCreationFlow/ip_lead_create_payload.dwl')]" />
			</munit:set-event>
			<flow-ref doc:name="BnW-Meta-Create_Lead_In_Salesforce_Flow" doc:id="e7a67219-e365-4f83-87c0-dd332e902701" name="BnW-Meta-Create_Lead_In_Salesforce_Flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-equals doc:name="Assert equals" doc:id="dea37982-fbec-43aa-963a-047aceb474ae" actual="#[payload.reason]" expected='Meta_Leadgen_ID__c not specified' message="Invalid Payload. Lead Cannot be created."/>
		</munit:validation>
	</munit:test>
