	<sub-flow name="error-message" doc:id="6ce8429d-0134-48cf-9d11-ba9808f7bd05" >
		<ee:transform doc:name="error message" doc:id="7ae59527-81b1-42ba-bd8e-42fd544a9718">
				<ee:message>
					<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  successful: false,
  message: "Lead creation failed",
  errorMessage: error.description,
  errorType: error.errorType
}]]></ee:set-payload>
				</ee:message>
			</ee:transform>
	</sub-flow>
	
	
	
	
	
	
